{
  "schemaVersion": 1,
  "vjoyDeviceId": 1,
  "stick": {
    "hand": "right",
    "pivot": [0.0, -0.45, -0.30],
    "grabRadiusM": 0.08,
    "mode": "displacement",
    "throwDeg": 20.0,
    "axes": {
      "roll": { "vjoy": "X", "invert": false, "deadzone": 0.02, "curve": { "type": "expo", "value": 0.3 } },
      "pitch": { "vjoy": "Y", "invert": false, "deadzone": 0.02, "curve": { "type": "expo", "value": 0.3 } }
    },
    "rudder": { "source": "thumbstickX", "vjoy": "Rz", "deadzone": 0.1, "curve": { "type": "linear" } },
    "smoothing": { "filter": "oneEuro", "minCutoff": 1.0, "beta": 0.05 },
    "onRelease": { "behavior": "center", "durationMs": 150 },
    "trim": { "source": "thumbstickY", "ratePerSecond": 0.1 }
  },
  "throttle": {
    "hand": "left",
    "zone": { "center": [-0.25, -0.40, -0.25], "size": [0.10, 0.10, 0.20] },
    "axisDirection": [0.0, 0.0, -1.0],
    "travelM": 0.15,
    "vjoy": "Z",
    "detents": [1.0],
    "onRelease": "hold",
    "thumbstickMode": { "enabled": false, "ratePerSecond": 0.5 }
  },
  "buttons": {
    "right.trigger": { "vjoyButton": 1 },
    "right.a": { "vjoyButton": 2 },
    "right.b": { "vjoyButton": 3 },
    "left.x": { "vjoyButton": 4 },
    "left.y": { "vjoyButton": 5 },
    "left.trigger": { "vjoyButton": 6 }
  }
}
